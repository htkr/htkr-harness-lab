# --- 秘密情報とローカル設定 -----------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.token
credentials.json
secrets.json

# ローカル専用・非公開の作業領域。実際の会社のテンプレート、プロンプト、元データ、
# スクリーンショット、生成物はここに置き、コミットしないこと。
.local/
private/
.local-private/

# 生成物と実行・セッション状態
artifacts/
output/
outputs/
runs/
run-data/
sessions/
logs/
*.log

# ローカルのプレゼンテーション用テンプレート・独自素材
local-templates/
company-templates/
private-templates/

# 一時ファイル
tmp/
temp/
.cache/
*.tmp
*.temp
*.swp
*.swo
*~

# --- Node / TypeScript -------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.yarn-cache/
.npm/
.npmrc.local
coverage/
.nyc_output/
dist/
build/
out/
*.tsbuildinfo
.eslintcache
.vite/
.next/
.turbo/
.parcel-cache/

# パッケージマネージャー・デバッグ用ログ
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyright/
.coverage
.coverage.*
htmlcov/
.venv/
venv/
env/
.python-version

# --- Rust / ネイティブ実装の実験 ----------------------------------------------
target/

# --- IDE / エディター ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.code-workspace

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- テスト・レンダリングツールのキャッシュ -------------------------------------------------
playwright-report/
test-results/
blob-report/
allure-results/

# LibreOffice / Officeのロックファイル
~$*.pptx
~$*.docx
~$*.xlsx

# 注意：
# 架空または公開可能なテスト用素材はGitで管理する場合があるため、
# *.pptx/*.pdf/*.png を一律に除外しない。機密資料や生成物は
# .local/、private/、artifacts/ に置く。
