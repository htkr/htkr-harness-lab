# --- Rust / native experiments ----------------------------------------------
target/

# --- IDE / editor ------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
*.code-workspace

# --- OS ----------------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Test/render tool caches -------------------------------------------------
playwright-report/
test-results/
blob-report/
allure-results/

# LibreOffice / Office lock files
~$*.pptx
~$*.docx
~$*.xlsx

# NOTE:
# Do not blanket-ignore *.pptx/*.pdf/*.png because synthetic/open test fixtures
# may legitimately be versioned. Put confidential or generated material under
# .local/, private/ or artifacts/ instead.
